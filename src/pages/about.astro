---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="আমাদের সম্পর্কে" description="মুক্তগ্রন্থ প্রকল্পের লক্ষ্য, অনুপ্রেরণা ও কারিগরী মান">
  <header class="page-header">
    <div class="container">
      <h1>আমাদের সম্পর্কে</h1>
      <p class="subtitle">মুক্তগ্রন্থ প্রকল্পের লক্ষ্য, অনুপ্রেরণা ও কারিগরী মান</p>
    </div>
  </header>

  <main class="container">
    <!-- Mission Section -->
    <section class="section">
      <h2 class="section-title">আমাদের লক্ষ্য</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: var(--color-text-muted); max-width: 800px; margin-bottom: var(--space-md);">
        মুক্তগ্রন্থ একটি উন্মুক্ত ডিজিটাল লাইব্রেরি উদ্যোগ। আমাদের প্রধান লক্ষ্য হলো বাংলা সাহিত্যের পাবলিক ডোমেইনভুক্ত কালজয়ী গ্রন্থসমূহকে <strong>Standard Ebooks</strong>-এর মতো বিশ্বমানের ই-বই সংস্করণে রূপান্তর করা।
      </p>
      <p style="font-size: 1.05rem; line-height: 1.8; color: var(--color-text-muted); max-width: 800px;">
        আমরা বিশ্বাস করি বাংলা সাহিত্যের অমূল্য রত্নগুলো সবার জন্য সহজলভ্য, দৃষ্টিবান্ধব এবং আধুনিক ডিজিটাল রিডারে পাঠযোগ্য হওয়া উচিত। সাধারণ স্ক্যান বা অপরিশোধিত ওসিআর (OCR) টেক্সটের বদলে আমরা নির্ভুল প্রুফরিডিং, নান্দনিক টাইপোগ্রাফি এবং আধুনিক ই-বই স্ট্যান্ডার্ড (EPUB3) নিশ্চিত করি।
      </p>
    </section>

    <!-- Inspiration Section -->
    <section class="section" style="padding-top: 0;">
      <h2 class="section-title">Standard Ebooks থেকে অনুপ্রেরণা</h2>
      <div class="card" style="background: var(--color-bg-warm);">
        <div class="card-icon">💡</div>
        <h3>মুক্ত ও বিশ্বমানের ডিজিটাল প্রকাশনা</h3>
        <p style="font-size: 0.98rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: var(--space-sm);">
          <strong>Standard Ebooks</strong> বিশ্বসাহিত্যের পাবলিক ডোমেইন বইগুলোকে মুক্ত ও সর্বাধুনিক ডিজিটাল প্রাতিষ্ঠানিক মানে রূপান্তরের যে পথিকৃৎ ভূমিকা রেখেছে, মুক্তগ্রন্থ বাংলা সাহিত্যের ক্ষেত্রে সেই একই দর্শন অনুসরণ করে।
        </p>
        <p style="font-size: 0.98rem; line-height: 1.8; color: var(--color-text-muted);">
          সঠিক সিমেন্টিক মার্কআপ, টাইপোগ্রাফিক পরিপূর্ণতা, কাস্টম কভার ডিজাইন এবং নিখুঁত এনকোডিংয়ের মাধ্যমে আমরা বাংলা ই-বই পাঠের অভিজ্ঞতাকে এক নতুন উচ্চতায় নিয়ে যেতে প্রতিশ্রুতিবদ্ধ।
        </p>
      </div>
    </section>

    <!-- Technical Standards Section -->
    <section class="section" style="padding-top: 0;">
      <h2 class="section-title">কারিগরী মান ও বৈশিষ্ট্য</h2>
      <p class="section-subtitle">মুক্তগ্রন্থের প্রতিটি ই-বই যেসকল সুনির্দিষ্ট কারিগরী নীতি মেনে তৈরি করা হয়:</p>

      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-btn" aria-expanded="false" aria-controls="acc-epub">
            <span>EPUB3 ফরম্যাট ও ওপেন স্ট্যান্ডার্ড</span>
            <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="acc-epub" class="accordion-body" hidden>
            <p>আমাদের সকল বই আন্তর্জাতিক <strong>EPUB 3.2</strong> মানদণ্ড অনুসরণ করে তৈরি।</p>
            <ul>
              <li>যেকোনো আধুনিক ই-রিডার (Kobo, Apple Books, Kindle), ট্যাবলেট ও স্মার্টফোনে নির্বিঘ্নে রিফ্লোয়েবল পাঠযোগ্যতা।</li>
              <li>সঠিক মেটাডাটা (Dublin Core) ও নেভিগেশন ডিস্ক অত্যন্ত নিখুঁতভাবে সংরক্ষিত।</li>
            </ul>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-btn" aria-expanded="false" aria-controls="acc-html">
            <span>Semantic HTML5 ও গঠনগত শুদ্ধতা</span>
            <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="acc-html" class="accordion-body" hidden>
            <p>বইয়ের কন্টেন্টকে সুনির্দিষ্ট HTML5 সিমেন্টিক এলিমেন্টে বিন্যস্ত করা হয়।</p>
            <ul>
              <li>অধ্যায় ও উপ-শিরোনামের জন্য যথাযথ <code>&lt;h1&gt;</code> থেকে <code>&lt;h6&gt;</code> কাঠামোর প্রয়োগ।</li>
              <li>কোটেশন, সংকেত এবং সারণীর জন্য <code>&lt;blockquote&gt;</code>, <code>&lt;cite&gt;</code> ও <code>&lt;aside&gt;</code> ট্যাগের পরিচ্ছন্ন ব্যবহার।</li>
            </ul>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-btn" aria-expanded="false" aria-controls="acc-unicode">
            <span>Unicode ও বাংলা লিপি সুরক্ষা</span>
            <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="acc-unicode" class="accordion-body" hidden>
            <p>সর্বাধুনিক ইউনিকোড এনকোডিং ব্যবহার করে বাংলা অক্ষরের মান রক্ষা করা হয়।</p>
            <ul>
              <li>যুক্তবর্ণের সঠিক রূপ ও ণ-ত্ব/ষ-ত্ব বিধানের যথাযথ প্রতিপালন।</li>
              <li>মূল বইয়ের ঐতিহাসিক বানানরীতি ও পাঠের স্বকীয়তা অক্ষুণ্ণ রাখা।</li>
            </ul>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-btn" aria-expanded="false" aria-controls="acc-font">
            <span>ফন্ট নির্বাচন ও এম্বেডিং</span>
            <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="acc-font" class="accordion-body" hidden>
            <p>পাঠের আরামদায়ক অভিজ্ঞতার জন্য প্রিমিয়াম উন্মুক্ত ফন্ট যুক্ত করা হয়।</p>
            <ul>
              <li>মূল টেক্সটের জন্য <strong>Noto Serif Bengali</strong> এবং শিরোনামের জন্য কাস্টম অক্ষরাঙ্কন।</li>
              <li>ই-বই ফাইলে সরাসরি লাইটওয়েট WOFF2/OTF ফন্ট এম্বেড করার ফলে সব ডিভাইসে সমান সুন্দর দেখায়।</li>
            </ul>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-btn" aria-expanded="false" aria-controls="acc-css">
            <span>CSS3 ও ডিজিটাল টাইপোগ্রাফি</span>
            <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="acc-css" class="accordion-body" hidden>
            <p>বইয়ের সুসংগত লেআউটের জন্য আধুনিক CSS3 রুলস ব্যবহৃত হয়।</p>
            <ul>
              <li>চোখের স্বস্তির জন্য সঠিক লাইন-হাইট (Line Height) ও মার্জিন বিন্যাস।</li>
              <li>পৃষ্ঠা বিরতিতে বিজোড় লাইন রোদ্রে Orphan & Widow প্রতিরোধ কন্ট্রোল।</li>
            </ul>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-btn" aria-expanded="false" aria-controls="acc-license">
            <span>উন্মুক্ত লাইসেন্সিং (CC BY-NC-SA 4.0)</span>
            <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="acc-license" class="accordion-body" hidden>
            <p>আমাদের প্রস্তুতকৃত ডিজিটাল ফাইলসমূহ সম্পূর্ণ উন্মুক্ত ও সর্বজনীন।</p>
            <ul>
              <li>মুক্তগ্রন্থের ফরম্যাটিং ও ডিজিটাল সংস্করণসমূহ Creative Commons Attribution-NonCommercial-ShareAlike 4.0 (CC BY-NC-SA 4.0) লাইসেন্সের আওতাভুক্ত।</li>
              <li>যে কেউ অবাণিজ্যিক উদ্দেশ্যে বিনামূল্যে শেয়ার, ব্যবহার ও রূপান্তর করতে পারবেন।</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const accordionBtns = document.querySelectorAll('.accordion-btn');
      accordionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          const bodyId = btn.getAttribute('aria-controls');
          const body = bodyId ? document.getElementById(bodyId) : btn.nextElementSibling;
          
          btn.setAttribute('aria-expanded', String(!expanded));
          if (body) {
            if (expanded) {
              body.setAttribute('hidden', '');
            } else {
              body.removeAttribute('hidden');
            }
          }
        });
      });
    });
  </script>
</BaseLayout>
