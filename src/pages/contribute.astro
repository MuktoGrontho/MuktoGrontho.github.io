---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="অবদান রাখুন" description="বাংলা সাহিত্যকে ডিজিটাল যুগে সমৃদ্ধ করতে মুক্তগ্রন্থ প্রকল্পে অবদান রাখুন">
  <header class="page-header">
    <div class="container">
      <h1>অবদান রাখুন</h1>
      <p class="subtitle">বাংলা সাহিত্যকে সমৃদ্ধ ও ডিজিটাইজ করতে আমাদের উন্মুক্ত উদ্যোগে অংশ নিন</p>
    </div>
  </header>

  <main class="container">
    <!-- 4 Ways to Contribute -->
    <section class="section">
      <h2 class="section-title">যেভাবে অবদান রাখতে পারেন</h2>
      <p class="section-subtitle">মুক্তগ্রন্থ একটি উন্মুক্ত ও কন্ট্রিবিউটর-বান্ধব প্রকল্প। আপনি নানাভাবে যুক্ত হতে পারেন:</p>

      <div class="card-grid">
        <div class="card">
          <div class="card-icon">🔍</div>
          <h3>প্রুফরিডিং</h3>
          <p>
            ওসিআরকৃত টেক্সটের ভুলত্রুটি সংশোধন, মূল বইয়ের স্ক্যানের সাথে বানান মিলিয়ে শুদ্ধকরণ এবং সঠিক বিরামচিহ্ন স্থাপন করা।
          </p>
        </div>

        <div class="card">
          <div class="card-icon">📖</div>
          <h3>ই-বই তৈরি</h3>
          <p>
            আমাদের স্টাইল গাইড মেনে Semantic HTML5 ও EPUB ফাইল তৈরি এবং আন্তর্জাতিক মানের কভার আর্টওয়ার্ক যুক্ত করা।
          </p>
        </div>

        <div class="card">
          <div class="card-icon">🛠️</div>
          <h3>টুল উন্নয়ন</h3>
          <p>
            অটোমেটেড বিল্ড পাইপলাইন, লিন্টার, টেক্সট স্ক্যানার ও ওয়েবসাইট কোড উন্নয়নে ভূমিকা রাখা।
          </p>
        </div>

        <div class="card">
          <div class="card-icon">💡</div>
          <h3>বই প্রস্তাব</h3>
          <p>
            পাবলিক ডোমেইনে আসা গুরুত্বপূর্ণ বাংলা সাহিত্যের তালিকা তৈরি এবং ডিজিটাইজেশনের নতুন বই প্রস্তাব করা।
          </p>
        </div>
      </div>
    </section>

    <!-- GitHub CTA Section -->
    <section class="section" style="padding-top: 0;">
      <div class="card" style="background: var(--color-bg-warm); text-align: center; padding: var(--space-2xl);">
        <div class="card-icon" style="font-size: 2.5rem; margin-bottom: var(--space-sm);">🚀</div>
        <h2 style="font-family: var(--font-serif); font-size: 1.5rem; margin-bottom: var(--space-sm);">GitHub কন্ট্রিবিউশন গাইড দেখুন</h2>
        <p style="max-width: 600px; margin-inline: auto; margin-bottom: var(--space-lg); color: var(--color-text-muted);">
          আমাদের প্রোডাকশন নির্দেশিকা, স্টাইল গাইড এবং কীভাবে গিটহাব পোল রিকোয়েস্ট (PR) পাঠাবেন তা জানতে কন্ট্রিবিউশন গাইডলাইন পড়ুন।
        </p>
        <a href="https://github.com/MuktoGrontho/muktogrontho/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          গিটহাব কন্ট্রিবিউশন গাইড ↗
        </a>
      </div>
    </section>

    <!-- Sources Section -->
    <section class="section" style="padding-top: 0;">
      <h2 class="section-title">আমাদের কন্টেন্ট ও স্ক্যান উৎস</h2>
      <p class="section-subtitle">পাবলিক ডোমেইন বইয়ের মূল টেক্সট ও হাই-রেজোলেশন স্ক্যানের প্রধান উৎসসমূহ:</p>

      <div class="card-grid">
        <div class="card">
          <div class="card-icon">🏛️</div>
          <h3>NDLI</h3>
          <p>
            National Digital Library of India — দুর্লভ বাংলা বই, প্রাচীন পাণ্ডুলিপি ও ঐতিহাসিক সাময়িকপত্রের ডিজিটাইজড সংগ্রাহক।
          </p>
        </div>

        <div class="card">
          <div class="card-icon">🌐</div>
          <h3>Internet Archive</h3>
          <p>
            বিশ্বব্যাপী উন্মুক্ত বই ও পাবলিক ডোমেইন আর্কাইভের সুবিশাল সংগ্রাহক এবং ডিজিটাল বইয়ের উন্মুক্ত ভাণ্ডার।
          </p>
        </div>

        <div class="card">
          <div class="card-icon">📚</div>
          <h3>Bengal Online</h3>
          <p>
            বাংলা সাহিত্যের দুর্লভ সংকলন, সাময়িকপত্র ও পাবলিক ডোমেইন বাংলা বইয়ের ডিজিটাইজেশন ড্রাইভ।
          </p>
        </div>

        <div class="card">
          <div class="card-icon">📜</div>
          <h3>বাংলা উইকিসংকলন</h3>
          <p>
            উইকিমিডিয়া ভলান্টিয়ারদের দ্বারা প্রুফরিডকৃত ও নিবন্ধিত উন্মুক্ত বাংলা টেক্সটের একটি বিশাল নির্ভরযোগ্য উৎস।
          </p>
        </div>

        <div class="card">
          <div class="card-icon">🏢</div>
          <h3>WB Public Library</h3>
          <p>
            West Bengal Public Library Network — পশ্চিমবঙ্গ পাবলিক লাইব্রেরির ডিজিটাল আর্কাইভ ও ঐতিহাসিক বইয়ের স্ক্যান কপি।
          </p>
        </div>

        <div class="card">
          <div class="card-icon">📂</div>
          <h3>National Archives (NAB)</h3>
          <p>
            National Archives of Bangladesh — বাংলাদেশের ইতিহাস, প্রাচীন পত্রিকা ও দুর্লভ সাহিত্য সংক্রান্ত পাবলিক আর্কাইভ।
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
